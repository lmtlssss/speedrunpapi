+
+  -- purpose: '1' when the division done by short_divide leaves a remainder.
+  -- The quotient of a floating-point divide is exact when it leaves none, and
+  -- rounding has to know which: the same stages as short_divide, keeping the
+  -- last partial remainder.
+  function short_divide_sticky (
+    lx, rx : UNSIGNED)
+    return STD_ULOGIC
+  is
+    constant stages       : INTEGER := lx'high - rx'high;  -- number of stages
+    variable partial      : UNSIGNED (lx'range);
+    variable partial_argl : SIGNED (rx'high + 2 downto 0);
+    variable partial_arg  : SIGNED (rx'high + 2 downto 0);
+  begin
+    partial := lx;
+    for i in stages downto 0 loop
+      partial_argl := resize ("0" & SIGNED (partial(lx'high downto i)),
+                              partial_argl'length);
+      partial_arg := partial_argl - SIGNED ("0" & rx);
+      if (partial_arg (partial_arg'high) = '0') then       -- not negative
+        partial (lx'high+i-stages downto lx'high+i-stages-rx'high) :=
+          UNSIGNED (partial_arg(rx'range));
+      end if;
+    end loop;
+    return or (partial (rx'high downto 0));
+  end function short_divide_sticky;
 
+  -- purpose: integer square root, one bit of the root per step.
+  -- arg has twice as many bits as root; root is the largest number whose
+  -- square does not exceed arg, and inexact says that the square is smaller.
+  procedure isqrt_floor (
+    arg     : in  UNSIGNED;
+    root    : out UNSIGNED;
+    inexact : out STD_ULOGIC) is
+    constant n     : NATURAL := root'length;
+    variable a     : UNSIGNED (2*n-1 downto 0);
+    variable r     : UNSIGNED (n-1 downto 0);
+    variable part  : UNSIGNED (n+1 downto 0);   -- partial remainder
+    variable trial : UNSIGNED (n+1 downto 0);
+  begin
+    a    := arg;
+    r    := (others => '0');
+    part := (others => '0');
+    for i in n-1 downto 0 loop
+      part  := part (n-1 downto 0) & a (2*i+1 downto 2*i);
+      trial := r & "01";
+      if part >= trial then
+        part := part - trial;
+        r    := r (n-2 downto 0) & '1';
+      else
+        r    := r (n-2 downto 0) & '0';
+      end if;
+    end loop;
+    root    := r;
+    inexact := or (part);
+  end procedure isqrt_floor;
