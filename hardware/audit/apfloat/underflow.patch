+
+TEST(APFloatTest, UnderflowTininessAfterRounding) {
+  // Tininess is detected after rounding: a result below the smallest normal
+  // number is tiny unless rounding it to the precision of the format, with the
+  // exponent range unbounded, gives the smallest normal number. Each value is
+  // a binary128 number just below 2^-1022 that is converted to binary64. The
+  // largest subnormal is 0x1.ffffffffffffep-1023; the comments say how far the
+  // value lies from it toward 2^-1022.
+  const int Tiny = APFloat::opUnderflow | APFloat::opInexact;
+  const int NotTiny = APFloat::opInexact;
+  const struct {
+    const char *Value;
+    APFloat::roundingMode RM;
+    const char *Result;
+    int Status;
+  } Tests[] = {
+      // Halfway. Exact in 53 bits, so tiny; the result rounds up to 2^-1022.
+      {"0x1.fffffffffffff0p-1023", APFloat::rmNearestTiesToEven, "0x1p-1022",
+       Tiny},
+      {"0x1.fffffffffffff0p-1023", APFloat::rmNearestTiesToAway, "0x1p-1022",
+       Tiny},
+      {"0x1.fffffffffffff0p-1023", APFloat::rmTowardPositive, "0x1p-1022",
+       Tiny},
+      {"-0x1.fffffffffffff0p-1023", APFloat::rmTowardNegative, "-0x1p-1022",
+       Tiny},
+      // Five eighths. In 53 bits it rounds down to the halfway point: tiny.
+      {"0x1.fffffffffffff4p-1023", APFloat::rmNearestTiesToEven, "0x1p-1022",
+       Tiny},
+      // A directed rounding to 53 bits reaches 2^-1022 instead: not tiny.
+      {"0x1.fffffffffffff4p-1023", APFloat::rmTowardPositive, "0x1p-1022",
+       NotTiny},
+      {"-0x1.fffffffffffff4p-1023", APFloat::rmTowardNegative, "-0x1p-1022",
+       NotTiny},
+      // Three quarters. The tie in 53 bits goes to 2^-1022: not tiny.
+      {"0x1.fffffffffffff8p-1023", APFloat::rmNearestTiesToEven, "0x1p-1022",
+       NotTiny},
+      {"0x1.fffffffffffff8p-1023", APFloat::rmNearestTiesToAway, "0x1p-1022",
+       NotTiny},
+      // Seven eighths.
+      {"0x1.fffffffffffffcp-1023", APFloat::rmNearestTiesToEven, "0x1p-1022",
+       NotTiny},
+      // One quarter, rounded up.
+      {"0x1.ffffffffffffe8p-1023", APFloat::rmTowardPositive, "0x1p-1022",
+       Tiny},
+      // A result that stays subnormal is tiny in every mode.
+      {"0x1.fffffffffffffcp-1023", APFloat::rmTowardZero,
+       "0x1.ffffffffffffep-1023", Tiny},
+      {"0x1.fffffffffffffcp-1023", APFloat::rmTowardNegative,
+       "0x1.ffffffffffffep-1023", Tiny},
+  };
+  for (const auto &T : Tests) {
+    SCOPED_TRACE(T.Value);
+    APFloat X(APFloat::IEEEquad(), T.Value);
+    bool LosesInfo = false;
+    APFloat::opStatus Status =
+        X.convert(APFloat::IEEEdouble(), T.RM, &LosesInfo);
+    EXPECT_TRUE(X.bitwiseIsEqual(APFloat(APFloat::IEEEdouble(), T.Result)));
+    EXPECT_EQ(T.Status, static_cast<int>(Status));
+    EXPECT_TRUE(LosesInfo);
+  }
+
+  // A subnormal source keeps the bits that decide it. The binary32 number
+  // 0x007f8000 is 1.1111111b * 2^-127, exact in the eight bits of bfloat:
+  // tiny. 0x007fc000 is 1.11111111b * 2^-127, which rounds to 2^-126 in eight
+  // bits: not tiny.
+  for (auto [Bits, Status] :
+       {std::pair(0x007f8000u, Tiny), std::pair(0x007fc000u, NotTiny)}) {
+    SCOPED_TRACE(Bits);
+    APFloat X(APFloat::IEEEsingle(), APInt(32, Bits));
+    bool LosesInfo = false;
+    EXPECT_EQ(Status, static_cast<int>(X.convert(APFloat::BFloat(),
+                                                 APFloat::rmNearestTiesToEven,
+                                                 &LosesInfo)));
+    EXPECT_EQ(APInt(16, 0x0080), X.bitcastToAPInt());
+  }
+
+  // The same through a multiplication. (1 - 2^-53) * 2^-1022 is exact in 53
+  // bits.
+  APFloat P(0x1.fffffffffffffp-1);
+  EXPECT_EQ(Tiny, static_cast<int>(P.multiply(APFloat(0x1p-1022),
+                                              APFloat::rmNearestTiesToEven)));
+  EXPECT_EQ(0x1p-1022, P.convertToDouble());
+  // (1 - 2^-52) * (1 + 2^-52) * 2^-1022 rounds to 2^-1022 in 53 bits.
+  APFloat Q(0x1.ffffffffffffep-1);
+  EXPECT_EQ(NotTiny,
+            static_cast<int>(Q.multiply(APFloat(0x1.0000000000001p-1022),
+                                        APFloat::rmNearestTiesToEven)));
+  EXPECT_EQ(0x1p-1022, Q.convertToDouble());
 }
 
